<?xml version="1.0"?>
<!-- ROS2 Humble full global-planning package and TrajectoryPoly interface. -->
<package format="3">
  <name>trajectory_generation</name>
  <version>0.1.0</version>
  <description>ROS2 Humble global planner, waypoint-compatible inputs, and polynomial trajectory interface.</description>
  <maintainer email="zzt@todo.todo">zzt</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <depend>ament_index_cpp</depend>
  <exec_depend>ament_index_python</exec_depend>
  <depend>builtin_interfaces</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>opencv4</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>waypoint_generator</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
