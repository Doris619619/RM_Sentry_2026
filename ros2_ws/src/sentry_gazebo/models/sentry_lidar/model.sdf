<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <!--Generated by lidar_assets.py: stage-one model with a real 360x4, 5 Hz lidar.-->
  <model name="sentry">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
        </inertia>
      </inertial>
      <visual name="body">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.7 0.5 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.3 0.65 1</ambient>
          <diffuse>0.05 0.35 0.8 1</diffuse>
        </material>
      </visual>
      <visual name="front">
        <pose>0.36 0 0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.35 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0.2 0.05 1</ambient>
          <diffuse>1 0.2 0.05 1</diffuse>
        </material>
      </visual>
      <visual name="turret">
        <pose>0 0 0.49 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.14 0.2 1</ambient>
          <diffuse>0.15 0.2 0.3 1</diffuse>
        </material>
      </visual>
      <visual name="front_pointer">
        <pose>0.24 0 0.5 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0.65 0.1 1</ambient>
          <diffuse>1 0.65 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0.7 0 0 0</pose>
        <topic>/sentry/lidar</topic>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>4</samples>
              <resolution>1</resolution>
              <min_angle>-0.1</min_angle>
              <max_angle>0.1</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>10</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
      <topic>/model/sentry/cmd_vel</topic>
    </plugin>
    <plugin filename="libsentry_resume_guard.so" name="sentry_gazebo::ResumeGuard" />
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/sentry/odometry</odom_topic>
    </plugin>
  </model>
</sdf>