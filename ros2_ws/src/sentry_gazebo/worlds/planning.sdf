<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <!--Generated by map_assets.py: map-aligned ideal planar scene, real lidar, no contact dynamics.-->
  <world name="sentry_planning">
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 0</gravity>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.86 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>RM Sentry - Basic Navigation</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.65 0.65 0.65</ambient_light>
        <background_color>0.82 0.86 0.9</background_color>
        <camera_pose>4 -10 12 0 0.92 2.2</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="View Control">
        <ignition-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World Control">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property type="double" key="width">120</property>
          <property type="double" key="height">65</property>
          <property type="double" key="x">0</property>
          <property type="double" key="y">0</property>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World Stats">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property type="double" key="width">280</property>
          <property type="double" key="height">110</property>
          <property type="double" key="x">0</property>
          <property type="double" key="y">70</property>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>
    <include>
      <uri>model://sentry_lidar</uri>
      <name>sentry</name>
      <pose>-0.919 -4.454 0 0 0 0</pose>
    </include>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <include>
      <uri>model://planning_map</uri>
    </include>
    <model name="ground">
      <static>true</static>
      <pose>-3.394 -2.0790000000000006 -0.03 0 0 0</pose>
      <link name="ground">
        <visual name="floor">
          <geometry>
            <box>
              <size>20 20 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.78 1</ambient>
            <diffuse>0.8 0.8 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>