<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <world name="sentry_physics">
    <physics name="fixed_step" type="ignored">
      <max_step_size>.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.82 0.86 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>RM Sentry - Basic Navigation</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.65 0.65 0.65</ambient_light>
        <background_color>0.82 0.86 0.9</background_color>
        <camera_pose>4 -5 4.5 0 0.61 2.245</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="View Control">
        <ignition-gui>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
      </plugin>
      <plugin filename="WorldControl" name="World Control">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property type="double" key="width">120</property>
          <property type="double" key="height">65</property>
          <property type="double" key="x">0</property>
          <property type="double" key="y">0</property>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World Stats">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property type="double" key="width">280</property>
          <property type="double" key="height">110</property>
          <property type="double" key="x">0</property>
          <property type="double" key="y">70</property>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <model name="floor">
      <static>true</static>
      <pose>0 0 -.05 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>20 20 .1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20 20 .1</size>
            </box>
          </geometry>
          <material>
            <ambient>.65 .68 .72 1</ambient>
            <diffuse>.65 .68 .72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="contact_wall">
      <static>true</static>
      <pose>2.5 0 .5 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>.2 2 1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>.2 2 1</size>
            </box>
          </geometry>
          <material>
            <ambient>.85 .3 .1 1</ambient>
            <diffuse>.85 .3 .1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="five_degree_ramp">
      <static>true</static>
      <pose>3 3 0.12450175059072904 0 -0.08726646259971647 0</pose>
      <link name="body">
        <collision name="collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>4 2 .1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4 2 .1</size>
            </box>
          </geometry>
          <material>
            <ambient>.3 .7 .3 1</ambient>
            <diffuse>.3 .7 .3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://sentry_physical</uri>
      <name>sentry</name>
      <pose>0 0 .02 0 0 0</pose>
    </include>
  </world>
</sdf>