<?xml version="1.0"?>
<!-- Native Fortress simulation, lidar bridge and coordinate adapters. -->
<package format="3">
  <name>sentry_gazebo</name><version>0.1.0</version>
  <description>Ideal planar navigation simulation for RM Sentry, Gazebo Fortress.</description>
  <maintainer email="maintainers@example.invalid">RM Sentry maintainers</maintainer><license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ignition-gazebo6</depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend><exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>tf2_sensor_msgs</exec_depend><exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-yaml</exec_depend><exec_depend>python3-pil</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <build_depend>qtbase5-dev</build_depend>
</package>
