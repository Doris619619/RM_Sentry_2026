<?xml version="1.0"?>
<package format="3">
  <name>sentry_rviz_tools</name>
  <version>0.1.0</version>
  <description>ROS 2 port of the actually-built Goal3DTool and Pose3DTool support.</description>
  <maintainer email="maintainers@example.invalid">RM Sentry maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>xvfb</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
